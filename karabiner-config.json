{
    "rules": [
        {
            "description": "Terminals: Option+Backspace deletes a word",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^co\\.zeit\\.hyper$",
                                "^co\\.zeit\\.hyperterm$",
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "delete_or_backspace",
                        "modifiers": {
                            "mandatory": [
                                "left_option"
                            ],
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "escape"
                        },
                        {
                            "key_code": "delete_or_backspace"
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Terminals: Control+Left/Right move by word",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^co\\.zeit\\.hyper$",
                                "^co\\.zeit\\.hyperterm$",
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "left_arrow",
                        "modifiers": {
                            "mandatory": [
                                "control"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "escape"
                        },
                        {
                            "key_code": "b"
                        }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^co\\.zeit\\.hyper$",
                                "^co\\.zeit\\.hyperterm$",
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "right_arrow",
                        "modifiers": {
                            "mandatory": [
                                "control"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "escape"
                        },
                        {
                            "key_code": "f"
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Control+arrows move by word and paragraph, as Option+arrows do (not terminals)",
