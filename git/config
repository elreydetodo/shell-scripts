; Primary git configuration entry point, used on every machine.
;
; This file is deliberately generic: it holds no name, no email, no key. Those
; live in git/host, which git/install.sh links to the host-<name> file for this
; machine, or writes when there is none. See git/README.md, and gpg/README.md
; to create a GPG key if you do not have one.
;
; Install by linking this whole directory as ~/.config/git, where git reads
; this file as its global configuration:
;     ln -s $(pwd)/git ~/.config/git
;
; The includes at the bottom are relative. Git resolves a relative include.path
; against the directory of the file containing it, as git found that file,
; without following links. That directory is ~/.config/git, the link, so the
; includes reach the files beside this one.

[branch]
#    sort = -committerdate

[color]
    ui = auto

[commit]
    gpgsign = true

[core]
    fsmonitor = true
    pager = delta | less
    untrackedCache = true
    whitespace = blank-at-eol,space-before-tab,tab-in-indent,tabwidth=4

[delta]
#    hyperlinks = true
    line-numbers = true
    navigate = true  # use n and N to move between diff sections
    syntax-theme = Catppuccin Mocha

[diff]
    algorithm = histogram
    colorMoved = default

[fetch]
    prune = true
#    pruneTags = true
    writeCommitGraph = true

[help]
    autocorrect = prompt

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictStyle = zdiff3

[pull]
    ff = only

[push]
    autoSetupRemote = true
    default = simple

[rebase]
    updateRefs = true

[rerere]
    enabled = true

[tag]
    sort = version:refname

[url "git@github.com:"]
    insteadOf = https://github.com/

; --- layered overrides, lowest priority first -------------------------------
; Git ignores a missing include target without complaint, so both includes
; below are safe on a machine where the file does not exist.

; 1. This machine's identity. Gitignored. git/install.sh links it to
;    host-<name> beside this file, where <name> is the machine's short host
;    name, or writes it when there is no such file.
[include]
    path = host

; 2. Employer overlay. Gitignored, and on work machines it is a symlink into a
;    private work repo -- so that repo can live anywhere and no path to it is
;    hardcoded here. On personal machines the file is absent and this does
;    nothing.
[include]
    path = work
